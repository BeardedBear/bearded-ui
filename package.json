{
  "name": "bearded-ui",
  "version": "0.1.0",
  "description": "Composants Vue 3 et design tokens partagés des projets Bearded*",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BeardedBear/bearded-ui.git"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/bearded-ui.js",
  "module": "./dist/bearded-ui.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/bearded-ui.js"
    },
    "./style.css": "./dist/bearded-ui.css"
  },
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "build:styleguide": "vite build --mode styleguide",
    "preview": "vite preview --outDir styleguide-dist",
    "prepare": "vite build"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.8",
    "@types/node": "^26.1.2",
    "@vue/tsconfig": "^0.9.1",
    "typescript": "^6.0.3",
    "vite": "^8.1.5",
    "vite-plugin-dts": "^4.5.4",
    "vue": "^3.5.40",
    "vue-tsc": "^3.3.8"
  }
}
