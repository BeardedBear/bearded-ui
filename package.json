{
  "name": "bearded-ui",
  "version": "0.2.6",
  "description": "Composants Vue 3 et design tokens partagés des projets Bearded*",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BeardedBear/bearded-ui.git"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/bearded-ui.js",
  "module": "./dist/bearded-ui.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/bearded-ui.js"
    },
    "./style.css": "./dist/bearded-ui.css"
  },
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "dev": "vite",
    "build": "bun test && bun run lint && vue-tsc --noEmit && vite build",
    "test": "bun test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "build:styleguide": "vite build --mode styleguide",
    "preview": "vite preview --outDir styleguide-dist",
    "release": "bun run scripts/release.ts",
    "prepare": "vite build"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^26.1.2",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.8.0",
    "eslint-plugin-perfectionist": "^5.10.0",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.8.0",
    "jiti": "^2.7.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vite-plugin-dts": "^4.5.4",
    "vue": "^3.5.40",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.8"
  },
  "dependencies": {
    "@phosphor-icons/vue": "^2.2.1"
  }
}
