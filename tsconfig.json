{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "compilerOptions": {
    "paths": { "@/*": ["./src/*"] },
    "types": ["node", "vite/client"],
    "noEmit": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.vue",
    "styleguide/**/*.ts",
    "styleguide/**/*.vue",
    "scripts/**/*.ts",
    "vite.config.ts"
  ]
}
